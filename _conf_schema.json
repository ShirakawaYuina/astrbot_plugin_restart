{
    "restart_method": {
        "description": "重启方式",
        "type": "string",
        "options": ["ssh", "docker_cli", "dashboard"],
        "default": "ssh",
        "hint": "ssh：通过 SSH 登录宿主机执行 docker restart，适合容器内运行；docker_cli：在当前环境直接执行 docker；dashboard：仅重启 AstrBot 核心进程。"
    },
    "ssh_host": {
        "description": "SSH 主机地址",
        "type": "string",
        "default": "",
        "hint": "宿主机 IP 或域名。若留空，会尝试复用 astrbot_plugin_ssh 的配置。"
    },
    "ssh_port": {
        "description": "SSH 端口",
        "type": "int",
        "default": 22,
        "hint": "通常为 22。"
    },
    "ssh_username": {
        "description": "SSH 用户名",
        "type": "string",
        "default": "",
        "hint": "登录宿主机的账号。"
    },
    "ssh_password": {
        "description": "SSH 密码",
        "type": "string",
        "default": "",
        "hint": "明文密码。若使用密钥登录，可留空。"
    },
    "ssh_private_key": {
        "description": "SSH 私钥内容",
        "type": "text",
        "default": "",
        "hint": "PEM 格式私钥内容。填写后优先使用密钥登录。"
    },
    "ssh_timeout": {
        "description": "SSH 超时时间",
        "type": "int",
        "default": 10,
        "hint": "连接与命令执行超时，单位秒。"
    },
    "ssh_use_sudo": {
        "description": "SSH 命令前加 sudo",
        "type": "bool",
        "default": false,
        "hint": "宿主机 Docker 需要 sudo 权限时开启。"
    },
    "ssh_known_hosts_path": {
        "description": "known_hosts 文件路径",
        "type": "string",
        "default": "",
        "hint": "留空则使用 astrbot_plugin_ssh 的 known_hosts 配置；若两边都为空，则使用 asyncssh 默认策略。"
    },
    "docker_containers": {
        "description": "需要重启的容器名称",
        "type": "list",
        "default": ["astrbot", "napcat"],
        "hint": "按顺序填写要执行 docker restart 的容器名。默认同时重启 astrbot 与 napcat。"
    },
    "restart_switch": {
        "description": "定时重启开关",
        "hint": "启用后，Astrbot将按照触发周期定时重启。可用命令 “定时重启 开/关”",
        "type": "bool",
        "default": true
    },
    "restart_cron": {
        "description": "定时重启的触发周期",
        "type": "string",
        "hint": "使用 Cron 表达式（分 时 日 月 周）定义。例如：“0 5 * * *” 表示每天 5:00 重启一次Astrbot",
        "default": "0 5 * * *"
    },
    "show_memory_info": {
        "description": "重启完后显示内存使用情况",
        "type": "bool",
        "default": true
    },
    "restart_cache": {
        "description": "重启缓存区",
        "type": "object",
        "invisible": true,
        "items": {
            "platform_id": {
                "description": "重启命令所在的平台",
                "type": "string"
            },
            "umo": {
                "description": "重启命令所在的会话",
                "type": "string"
            },
            "start_ts": {
                "description": "重启命令发送时间",
                "type": "float"
            }
        }
    }
}
